# Grace configuration
# Copy this file to .env (or set the same names as variables in your panel).
# Only the Required section must be filled in.

# ---------- Required ----------
BOT_TOKEN=
CLIENT_ID=
OWNER_ID=
DATABASE_URL=postgres://user:password@host:5432/dbname

# ---------- General ----------
BOT_NAME=grace
PREFIX=,
SUPPORT_SERVER=            # invite link, used for the support link in botinfo and help
WEBSITE=
PREMIUM_URL=
STATUS=
STATUS_ROTATE_SECONDS=
STREAM_URL=
HELP_BANNER=               # direct image link shown at the top of the help menu

# ---------- Database ----------
DATABASE_SSL=              # true or false; empty detects automatically
DB_POOL_MAX=10
OLD_DATABASE_URL=          # set once to copy data from another database at startup, then remove
POSTGRES_PASSWORD=         # only for docker-compose.postgres.yml

# ---------- Music (Lavalink) ----------
# Leave LAVALINK_HOSTS empty to run without music. Multiple nodes are comma separated.
LAVALINK_HOSTS=
LAVALINK_PORTS=2333
LAVALINK_PASSWORDS=youshallnotpass
LAVALINK_SECURES=false
MUSIC_DEFAULT_PLATFORM=spsearch    # spsearch (needs LavaSrc) or ytsearch
MUSIC_AUTOCOMPLETE_LIMIT=
MUSIC_PLAYLIST_LIMIT=
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
GENIUS_API_KEY=
LASTFM_API_KEY=
LASTFM_API_SECRET=

# ---------- AI chat (free tiers available, set the ones you have) ----------
GEMINI_API_KEY=
GROQ_API_KEY=
CEREBRAS_API_KEY=
OPENROUTER_API_KEY=
# GEMINI_MODEL=
# GROQ_MODEL=
# GROQ_VISION_MODEL=
# CEREBRAS_MODEL=
# OPENROUTER_MODEL=
# OPENROUTER_VISION_MODEL=
# GUARD_AI_MODEL=

# ---------- AI media ----------
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
POLLINATIONS_API_KEY=
SARVAM_API_KEY=
REMOVEBG_API_KEY=

# ---------- Social and lookups ----------
SOCIALCRAWL_API_KEY=
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
SOCIAL_POLL_MINUTES=
SERPAPI_API_KEY=
ABUSEIPDB_KEY=
# PINTEREST_COOKIE=        # only if Pinterest blocks your host
# CATBOX_USERHASH=
# IMGLINK_HOST=
